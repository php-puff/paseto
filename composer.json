{
    "name": "puff/paseto",
    "description": "PASETO authentication pipeline for Puff",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "paragonie/paseto": "^3.5",
        "psr/http-message": "^2.0",
        "puff/config": "dev-main",
        "puff/di": "dev-main",
        "puff/http": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Puff\\Paseto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puff\\Paseto\\Tests\\": "tests/"
        }
    },
    "extra": {
        "puff": {
            "providers": [
                "Puff\\Paseto\\ServiceProvider"
            ],
            "config": {
                "paseto.php": "config/paseto.php"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "analyse": "phpstan analyse src tests --level=8"
    }
}